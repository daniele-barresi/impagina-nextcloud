{
	"name": "daniele-barresi/impagina-nextcloud",
	"description": "Nextcloud app for the impagina service: convert Markdown files to PDF",
	"license": "MIT",
	"authors": [
		{
			"name": "Daniele Barresi",
			"email": "daniele.barresi@gmail.com"
		}
	],
	"homepage": "https://github.com/daniele-barresi/impagina-nextcloud",
	"support": {
		"issues": "https://github.com/daniele-barresi/impagina-nextcloud/issues",
		"source": "https://github.com/daniele-barresi/impagina-nextcloud"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Impagina\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Impagina\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './node_modules/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"rector": "rector process --dry-run",
		"rector:fix": "rector process",
		"test:unit": "phpunit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky"
	},
	"require": {
		"php": "^8.3",
		"bamarni/composer-bin-plugin": "^1.8"
	},
	"require-dev": {
		"nextcloud/ocp": "^33.0.0",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3.0"
		}
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": true,
			"forward-command": true
		}
	}
}
